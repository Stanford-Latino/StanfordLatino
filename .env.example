# Copy this file to .env.local (for running on your computer)
# and add the same two values in your host's Environment Variables settings.
# Both come from Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Your live site address (used in the login email link)
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
